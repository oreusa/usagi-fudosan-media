        //tab
        $(".menu-options a").click(function () {
            $(this).parent().addClass("active").siblings(".active").removeClass("active");
            var tabContents = $(this).attr("href");
            $(tabContents).addClass("active").siblings(".active").removeClass("active");
            return false;
        });

        //デフォルトで表示するタブ。クエリパラメータがある場合、そのタブをデフォルトで表示する
        let tabs = ['today', 'news', 'event'];
        let selectedTab = getParam('tab');

        if ($.inArray(selectedTab, tabs) !== -1) {
            $('.menu-options a.' + selectedTab).trigger('click');
        } else {
            //表示されている最初のタブをクリックし、中身を表示
            $('.menu-options a:visible:first').trigger('click');
        }

        //一覧で隠された記事を表示する
        $('.more-btn').on('click', function () {
            $('.list', $(this).prev()).removeClass('hide');
            $(this).addClass('hide');//ボタンを隠す
            return false;
        });
