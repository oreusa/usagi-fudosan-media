<script>
(function () {
    function setupBannerSlide(trackId, dotsId) {
        var track = document.getElementById(trackId);
        if (!track) return;

        var slideEl = track.closest('.card-banner-slide');
        if (!slideEl) return;

        var prevBtn = slideEl.querySelector('.card-banner-nav--prev');
        var nextBtn = slideEl.querySelector('.card-banner-nav--next');
        var dotsContainer = document.getElementById(dotsId);

        // ドット生成
        var items = track.querySelectorAll('.card-banner-item');
        if (dotsContainer && items.length > 1) {
            items.forEach(function (item, index) {
                var dot = document.createElement('span');
                dot.className = 'card-banner-dot' + (index === 0 ? ' active' : '');
                dot.addEventListener('click', function () {
                    var item = track.querySelector('.card-banner-item');
                    var gap = 16;
                    var itemWidth = item.offsetWidth;
                    var distance = (itemWidth + gap) * index;
                    track.scrollLeft = distance;
                });
                dotsContainer.appendChild(dot);
            });
        }

        function updateDots() {
            if (!dotsContainer) return;
            var item = track.querySelector('.card-banner-item');
            if (!item) return;
            var itemWidth = item.offsetWidth;
            var gap = 24;
            var currentIndex = Math.round(track.scrollLeft / (itemWidth + gap));
            var dots = dotsContainer.querySelectorAll('.card-banner-dot');
            dots.forEach(function (dot, index) {
                dot.classList.toggle('active', index === currentIndex);
            });
        }

        function scrollByCard(direction) {
            var item = track.querySelector('.card-banner-item');
            if (!item) return;
            var gap = 24;
            var itemWidth = item.offsetWidth;
            var distance = (itemWidth + gap) * direction;
            track.scrollBy({ left: distance, behavior: 'smooth' });
        }

        if (prevBtn) {
            prevBtn.addEventListener('click', function (e) {
                e.preventDefault();
                scrollByCard(-1);
            });
        }
        if (nextBtn) {
            nextBtn.addEventListener('click', function (e) {
                e.preventDefault();
                scrollByCard(1);
            });
        }

        // スクロール時にドット更新
        track.addEventListener('scroll', updateDots);
        track.addEventListener('scrollend', updateDots);
    }

    // 両方のスライドを初期化
    setupBannerSlide('cardBannerTrackOpen', 'dotsOpen');
    setupBannerSlide('cardBannerTrackUpcoming', 'dotsUpcoming');

    // GA4 バナークリック追跡
    document.querySelectorAll('.card-banner-track a').forEach(function (link) {
        link.addEventListener('click', function (e) {
            var title = this.querySelector('.card-banner-item__title')?.innerText || 'Unknown';
            var trackId = this.closest('.card-banner-track')?.id || '';
            var section = trackId === 'cardBannerTrackOpen' ? '開催中のイベント' : '開催予定のイベント';

            if (typeof gtag !== 'undefined') {
                gtag('event', 'banner_click', {
                    'banner_name': title,
                    'banner_section': section,
                    'banner_url': this.href
                });
            }
        });
    });
})();
</script>


