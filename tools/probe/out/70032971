  <script async>
    var pageTop = $('#pagetopbutton');
    var timeout;
    $(function() {
      $(window).on('scroll resize', function () {
        pagetop_pos();
        if ($(window).scrollTop() > 300) {
          if (pageTop.css("display") == "none") {
            pageTop.fadeIn();
          }
        } else {
          if (pageTop.css("display") != "none") {
            pageTop.fadeOut();
          }
        }
      });

      pageTop.click(function () {
        $('body, html').animate({scrollTop:0}, 500, 'swing');
      });

    });
    function pagetop_pos(offset) {
      var offset = $('#foot_modori').offset().left;
      var width = $('#foot_modori').width();
      var wx = offset + width - 100;
      if ($(window).width() > 960) {
        pageTop.css("left", wx + 'px');
      } else if ($(window).width() < 900) {
        pageTop.css("left", 'auto');
      } else {
        pageTop.css("left", '860px');
      }
    }
  </script>
