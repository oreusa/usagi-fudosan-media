		$('.cal_date').on("click",function(event){
			event.preventDefault();
			$('.cal_date').removeClass("active");

			var val = $(this).attr('data-cal');
			$(this).addClass("active");
			$(".cal_date[data-cal='" + val + "']").addClass("active");

			$('.schedule').hide();
			$('#timeSchedule_' + val).show();
		});

			//$("#cal_1215").trigger("click");
		$(".cal_date[data-cal='1120']").trigger("click");
	});
	</script>

</body>
</html>