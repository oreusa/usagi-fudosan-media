<script src="https://www.shigamuseum.jp/wordpress/wp-content/themes/shigamuseum/assets/libs/fancybox/jquery.fancybox.min.js"></script>
<script>

  // Gallery
  $('[data-fancybox="gallery"]').fancybox({
    loop: true,
    toolbar: false,
    smallBtn: true,
  });

  // Slide / exhibition
  const slideLength = document.querySelectorAll('.sm-m-slide_exhibition .swiper-slide').length

  if (slideLength > 1) {
    const swiper = new Swiper('.sm-m-slide_exhibition', {
      loop: true,
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      autoplay: {
        delay: 3000,
        disableOnInteraction: false,
      },
      speed: 1000,
    })
  }

  // Slide / event
  (function() {

    'use strict';

    const breakpoint = window.matchMedia( '(max-width:768px)' );

    let mySwiper;
    const breakpointChecker = function() {

      if ( breakpoint.matches === true ) {
        if ( mySwiper !== undefined ) mySwiper.destroy( true, true );
          return;
        } else if ( breakpoint.matches === false ) {
          return enableSwiper();
        }
    };

    const enableSwiper = function() {
      mySwiper = new Swiper ('.sm-m-slide_event', {
        direction: 'horizontal',
        slidesPerView: 3,
        navigation: {
          nextEl: '.swiper-button-next',
          prevEl: '.swiper-button-prev',
        },
      });
    };

    // keep an eye on viewport size changes
    breakpoint.addListener(breakpointChecker);

    // kickstart
    breakpointChecker();

  })();
</script>



