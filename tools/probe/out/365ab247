/v1/fill/w_588,h_588,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/%E6%B2%B3%E9%87%8E%E7%B4%94%E5%96%9C.jpg 2x" id="img_comp-mrve17l0" src="https://static.wixstatic.com/media/13d1f5_153e9c45a40a41d7903e7afd8976aa14~mv2.jpg/v1/fill/w_294,h_294,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/%E6%B2%B3%E9%87%8E%E7%B4%94%E5%96%9C.jpg" alt="KASHIHARA SKY PALETTE 万葉花火" style="object-fit:cover" class="sh3KLT sFiSiq" width="294" height="294"/></div></div><!--/$--><!--$--><div id="comp-mrve7ltz" class="comp-mrve7ltz wH18kY"><div data-mesh-id="comp-mrve7ltzinlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mrve7ltzinlineContent-gridContainer" data-testid="mesh-container-content"><!--$--><div id="comp-mrve1ywe" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mrve1ywe wixui-rich-text" data-testid="richTextElement"><h6 class="font_6 wixui-rich-text__text" style="font-size:25px;"><span class="color_36 wixui-rich-text__text">公式アンバサダー</span></h6></div><!--/$--><!--$--><div id="comp-mrve62yp" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mrve62yp wixui-rich-text" data-testid="richTextElement"><h4 class="font_4 wixui-rich-text__text" style="font-size:35px;"><span class="color_36 wixui-rich-text__text">河野 純喜</span></h4></div><!--/$--><!--$--><div id="comp-mrve1ywf1" class="comp-mrve1ywf1 nJiBti wixui-horizontal-line"></div><!--/$--></div></div></div><!--/$--><!--$--><div id="comp-mrve1ywb" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mrve1ywb wixui-rich-text" data-testid="richTextElement"><p class="font_9 wixui-rich-text__text" style="text-align:justify; font-size:14px;"><span class="color_36 wixui-rich-text__text">人気グローバルボーイズグループ「JO1」のメンバーで奈良県出身である河野純喜さんが万葉花火の公式アンバサダーに就任！</span></p>

<p class="font_9 wixui-rich-text__text" style="text-align:justify; font-size:14px;"><span class="color_36 wixui-rich-text__text">当日はご本人によるスペシャルパフォーマンスを実施するほか、JO1の楽曲とシンクロした花火演出の特別パフォーマンスも予定しています</span></p></div><!--/$--><!--$--><div id="comp-mu3f1w1w" class="gpDCD5 comp-mu3f1w1w"><div class="jv9xi4 wixui-box" data-testid="container-bg"></div><div data-mesh-id="comp-mu3f1w1winlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mu3f1w1winlineContent-gridContainer" data-testid="mesh-container-content"><!--$--><div id="comp-mu3f46sq" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mu3f46sq wixui-rich-text" data-testid="richTextElement"><h4 class="font_4 wixui-rich-text__text" style="text-align:center; font-size:35px;">ご本人から皆様へ</h4></div><!--/$--><!--$--><div id="comp-mu3f2dg0" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mu3f2dg0 wixui-rich-text" data-testid="richTextElement"><p class="font_9 wixui-rich-text__text" style="text-align:justify; font-size:14px;">この度、僕の故郷奈良で開催される万葉花⽕でパフォーマンスをさせていただくことになりました。<br class="wixui-rich-text__text">
今年は奈良の「⾶⿃‧藤原の宮都」が世界遺産に登録されたという素晴らしい年であり、その記念すべき年に開催される万葉花⽕に携わることができて本当に光栄に思います。素晴らしい⼟地と美しい花⽕をバックに精⼀杯歌います。皆さんとの最⾼の思い出になるよう頑張ります。当⽇⼀緒に楽しみましょう！</p></div><!--/$--></div></div></div><!--/$--><!--$--><div id="comp-mrve8hrw" class="comp-mrve8hrw nJiBti wixui-horizontal-line"></div><!--/$--><!--$--><div id="comp-mrve8nqg" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mrve8nqg wixui-rich-text" data-testid="richTextElement"><p class="font_9 wixui-rich-text__text" style="text-align:justify; font-size:14px;"><span class="color_36 wixui-rich-text__text">サバイバルオーディション番組「PRODUCE 101 JAPAN」において視聴者投票により選出され、グローバルボーイズグループJO1のメンバーとして2020年にデビュー。デビュー以降、これまでにリリースしたすべてのシングルが主要音楽チャートで1位を獲␀得。2025年には世界6都市を巡るワールドツアーや初の単独東京ドーム公演も開催、2026年は10月2日に全米デビュー作『ANIMAL』をリリース。さらに北米ツアーも控えており、国内外で活動を展開している。メインボーカルとしてグループを牽引するほか、テレビ番組やドラマなどのメディア出演にも積極的に取り組み、アーティスト活動と並行して活動の幅を広げている。</span></p></div><!--/$--></div></div></section><!--/$--><!--$--><section id="comp-mv6bw4ws" tabindex="-1" class="Le88gL comp-mv6bw4ws wixui-section" data-block-level-container="ClassicSection"><div id="bgLayers_comp-mv6bw4ws" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mv6bw4ws" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-mv6bw4ws" data-motion-part="BG_MEDIA comp-mv6bw4ws" class="ROWgFb"></div></div><div data-mesh-id="comp-mv6bw4wsinlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mv6bw4wsinlineContent-gridContainer" data-testid="mesh-container-content"><!--$--><div id="comp-mv6bwzkz" class="hhxEkR comp-mv6bwzkz wixui-image cs40a3"><a data-testid="linkElement" href="https://sky-palette.hanabifes.com/campaign" target="_self" class="v9ZE1l"><img loading="lazy" sizes="889px" srcSet="https://static.wixstatic.com/media/13d1f5_16f3e81e73e24c7094b1b428c62eeb82~mv2.png/v1/fill/w_889,h_441,al_c,q_90,usm_0.66_1.00_0.01,enc_avif,quality_auto/%E3%82%AD%E3%83%A3%E3%83%B3%E3%83%9A%E3%83%BC%E3%83%B32.png 1x, https://static.wixstatic.com/media/13d1f5_16f3e81e73e24c7