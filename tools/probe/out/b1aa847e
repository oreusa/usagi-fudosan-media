<script>
$(function() {
  function setupPanelToggle() {
    var windowWidth = $(window).width();
    if (windowWidth < 1000) {
      $("#panel").hide();
      $("#panel-btn-icon").removeClass("close");
      $("#panel-btn").off('click').on('click', function() {
        $("#panel").slideToggle(200);
        $("#panel-btn-icon").toggleClass("close");
        return false;
      });
    } else {
      $("#panel").show();
      $("#panel-btn-icon").removeClass("close");
      $("#panel-btn").off('click');
    }
  }
  setupPanelToggle();
  $(window).resize(function() {
    setupPanelToggle();
  });
});
</script>
