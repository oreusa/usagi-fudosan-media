<script>
(function () {

  function initSpotZoom() {

    const modal = document.getElementById('spot_modal');

    if (!modal) return;

    const modalImg = modal.querySelector('img');

    document.querySelectorAll('.spot_image').forEach(function(link) {

      link.addEventListener('click', function(e) {

        /* PCのみ拡大 */
        if (window.innerWidth <= 767) {
          e.preventDefault();
          return;
        }

        /* 画像ファイルへ直接移動させない */
        e.preventDefault();

        const image = this.querySelector('img');

        modalImg.src = this.getAttribute('href');
        modalImg.alt = image ? image.alt : '';

        modal.classList.add('is_open');

        document.body.style.overflow = 'hidden';

      });

    });


    /* 拡大画面クリックで閉じる */
    modal.addEventListener('click', function() {

      modal.classList.remove('is_open');

      modalImg.src = '';
      modalImg.alt = '';

      document.body.style.overflow = '';

    });


    /* ESCキーで閉じる */
    document.addEventListener('keydown', function(e) {

      if (
        e.key === 'Escape' &&
        modal.classList.contains('is_open')
      ) {

        modal.classList.remove('is_open');

        modalImg.src = '';
        modalImg.alt = '';

        document.body.style.overflow = '';

      }

    });

  }


  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSpotZoom);
  } else {
    initSpotZoom();
  }

})();
