<style id="tcd_custom_css">/* =========================================
   HIKARIUM TOP
   TCDの余白設定はそのまま使用
   背景だけブラックに統一
========================================= */

/* コンテンツビルダー全体 */
body.home #index_content_builder {
  background-color: #000 !important;
  display: flow-root;
}

/* 各コンテンツ */
body.home #index_content_builder .cb_contents {
  background-color: #000 !important;
  display: flow-root;
}

/* TCDの白背景指定を黒に上書き */
body.home #index_content_builder .white,
body.home #index_content_builder .index_free_space,
body.home #index_content_builder .cb_free_space {
  background-color: #000 !important;
}

/* 内部は背景を引き継ぐ */
body.home #index_content_builder .cb_contents_inner,
body.home #index_content_builder .post_content,
body.home #index_content_builder .tcdce-body {
  background-color: transparent !important;
}


/* ==============================
   NEWS
============================== */

body.home #cb_content_4 .cb_catch,
body.home #cb_content_5 .cb_catch,
body.home #cb_content_6 .cb_catch {
  color: #fff !important;
}


/* ==============================
   INFORMATION MENU
============================== */

.icon_menu {
  display: grid !important;
  grid-template-columns: repeat(6, 1fr);
  gap: 20px;
  width: 100%;
}

.icon_menu a {
  display: flex !important;
  align-items: flex-start !important;
  justify-content: center !important;
  min-width: 0;
  margin: 0 !important;
  padding: 0 0 30px !important;
  box-sizing: border-box;
}

.icon_menu img {
  display: block !important;
  height: auto !important;
  margin: 0 auto !important;
  transform: none !important;
}

/* INFORMATION画像 */
.icon_menu > img {
  width: 203px !important;
  max-width: 100% !important;
}

/* 入場料金〜アクセス */
.icon_menu > a img {
  width: 233px !important;
  max-width: 115% !important;
}


/* ==============================
   AREA INFORMATION
============================== */

/* PC：4列 */
.spot_grid {
  display: grid !important;
  grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
  gap: 60px 30px;
  width: 100%;
}

/* TCD自動挿入タグ対策 */
.spot_grid > p,
.spot_grid > br,
.spot_image > br {
  display: none !important;
}

/* 各ブロック */
.spot_item {
  width: 100%;
  min-width: 0;
  margin: 0 !important;
  padding: 0 !important;
}

/* 写真エリア */
.spot_image {
  display: block !important;
  width: 100%;
  aspect-ratio: 16 / 9;
  margin: 0 !important;
  padding: 0 !important;
  overflow: hidden;
  background: #000;
  font-size: 0 !important;
  line-height: 0 !important;
  cursor: zoom-in;
}

/* 写真 */
.spot_image img {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 0 !important;
  object-fit: cover;
  vertical-align: bottom;
  transition: transform 0.35s ease;
}

/* hover */
.spot_image:hover img {
  transform: scale(1.03);
}

/* タイトル */
.spot_item h3 {
  margin: 18px 0 10px !important;
  padding: 0 !important;
  color: #fff;
  font-size: 20px;
  line-height: 1.6;
}

/* 本文 */
.spot_item p {
  display: block !important;
  margin: 0 !important;
  padding: 0 !important;
  color: #fff;
  font-size: 14px;
  line-height: 2;
}


/* ==============================
   PCのみ画像クリック拡大
============================== */

@media screen and (min-width: 768px) {

  #spot_modal {
    position: fixed;
    inset: 0;
    z-index: 9999999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 40px;
    box-sizing: border-box;
    background: rgba(0, 0, 0, 0.92);
    cursor: zoom-out;
  }

  #spot_modal.is_open {
    display: flex !important;
  }

  #spot_modal img {
    display: block !important;
    width: auto !important;
    height: auto !important;
    max-width: 90vw !important;
    max-height: 88vh !important;
    margin: 0 !important;
    padding: 0 !important;
    object-fit: contain !important;
  }
}


/* ==============================
   スマホ
============================== */

@media screen and (max-width: 767px) {

  .icon_menu {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px 10px;
  }

  .icon_menu a {
    padding-bottom: 20px !important;
  }

  .icon_menu img {
    max-width: 100% !important;
    height: auto !important;
  }

  .spot_grid {
    grid-template-columns: 1fr !important;
    gap: 50px 0;
  }

  .spot_item h3 {
    font-size: 18px;
  }

  .spot_item p {
    font-size: 14px;
    line-height: 1.9;
  }

  .spot_image {
    cursor: default;
  }

  /* スマホではモーダルを出さない */
  #spot_modal {
    display: none !important;
  }
}



/* ==============================
   スクロール フェードイン
============================== */

.fadein {
  opacity: 0;
  transform: translateY(40px);
  transition:
    opacity 1s ease,
    transform 1s ease;
}

.fadein.is-show {
  opacity: 1;
  transform: translateY(0);
}


/* ==============================
   グローバルメニュー
   ホバー・現在ページ
============================== */

body.home #global_menu > ul > li > a:hover,
#global_menu > ul > li.current-menu-item > a,
#global_menu > ul > li.current-menu-ancestor > a,
#global_menu > ul > li.active > a,
#global_menu > ul > li.active_button > a {
  color: #00a7ce !important;
}

@media screen and (max-width: 767px) {

  #menu_button span,
  #menu_button:hover span {
    background: #fff !important;
  }

}


/* ==============================
   ページ内アンカーをスムーズスクロール 
============================== */
html {
  scroll-behavior: smooth;
}

/* 固定ヘッダー分の余白 */
[id] {
  scroll-margin-top: 100px;
}

/* リンク付き画像：マウスオーバーで透明 */
a img {
  transition: opacity 0.3s ease;
}

a:hover img {
  opacity: 0.6;
}</style>
