<script>
  document.addEventListener('DOMContentLoaded', function () {
  const openBtns = document.querySelectorAll('.js-illumination-btn-modal');
  const header = document.querySelector('header');
  const html = document.documentElement;

  function closeModal(modal) {
    modal.classList.remove('is-show');
    header.style.zIndex = '';
    html.style.overflow = '';
  }

  openBtns.forEach(function (openBtn) {
    const targetId = openBtn.dataset.modalTarget;
    const modal = document.getElementById(targetId);
    if (!modal) return;

    const modalContent = modal.querySelector('.illumination-modal__wrapper');
    const closeBtn = modal.querySelector('.js-illumination-modal-close');
    if (!modalContent || !closeBtn) return;

    // Open modal
    openBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      modal.classList.toggle('is-show');

      const isShown = modal.classList.contains('is-show');
      header.style.zIndex = isShown ? '-1' : '';
      html.style.overflow = isShown ? 'hidden' : '';
    });

    // Prevent close when clicking inside content
    modalContent.addEventListener('click', function (e) {
      e.stopPropagation();
    });

    // Close when clicking outside content
    modal.addEventListener('click', function () {
      closeModal(modal);
    });

    // Close when clicking close button
    closeBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      closeModal(modal);
    });
  });
});
</script>

