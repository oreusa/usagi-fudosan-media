    <script>
    const navInfoBlock = document.querySelector('.nav__info-block');
    if (navInfoBlock) {
        const today = new Date();
        let calYear = today.getFullYear().toString();
        let m = today.getMonth() + 1;
        let calMonth = ('0' + m).slice(-2);
        let calDay = ('0' + today.getDate()).slice(-2);
        const uri = new URL(window.location.href);
        const ticketURL = uri.protocol + '//' + uri.hostname + '/wp-json/wp/v2/sales_calendar?calendar_day=' + calYear + calMonth + calDay;
        // console.log(ticketURL);
        fetch(ticketURL)
            .then(response => {
            if (!response.ok) {
                throw new Error('Network response was not ok');
            }
            return response.json();
        })
        .then(tickets => {
            const ticket = tickets[0];
            const calendar_date = ticket.acf.calendar_date;
            const calendar_starttime = ticket.acf.calendar_starttime;
            const calendar_endtime = ticket.acf.calendar_endtime;
            const ticket_type = ticket.acf.type;
            const days = [
                " (日)の営業時間",
                " (月)の営業時間",
                " (火)の営業時間",
                " (水)の営業時間",
                " (木)の営業時間",
                " (金)の営業時間",
                " (土)の営業時間",
            ];
            const year = parseInt( calendar_date.substr(0, 4) );
            const month = parseInt( calendar_date.substr(4, 2) ) - 1;
            const day = parseInt( calendar_date.substr(6, 2) );
            const specDate = new Date(year, month, day);
            let calDateText = '';
            if (ticket_type == 'closed') {
                calDateText = '休園日';
            }
            else if (ticket_type == 'temporary_closed') {
                calDateText = '臨時休園';
            }
            else {
                calDateText = calendar_starttime.substr(0, calendar_starttime.length - 3) + '～' + calendar_endtime.substr(0, calendar_endtime.length - 3);
            }
            let month_txt = calendar_date.substr(4, 2);
            let day_txt = calendar_date.substr(6, 2);
            let weekday_txt = days[specDate.getDay()];
            // sidebar
            let calDate = document.querySelector('.nav__info-date');
            if (calDate) {
                calDate.innerHTML = year + '.' + month_txt + '.' + day_txt + weekday_txt;
            }
            let calTime = document.querySelector('.nav__info-time');
            if (calTime) {
                calTime.innerHTML = calDateText;
            }
            // toppage
            let calDate_Toppage = document.querySelector('.top__info-date');
            if (calDate_Toppage) {
                calDate_Toppage.innerHTML = year + '.' + month_txt + '.' + day_txt + weekday_txt;
            }
            let calTime_Toppage_sp = document.querySelector('.top__mv-info-time');
            if (calTime_Toppage_sp) {
                calTime_Toppage_sp.innerHTML = calDateText;
            }
            let calTime_Toppage_pc = document.querySelector('.top__info-sched-icon-box span');
            if (calTime_Toppage_pc) {
                calTime_Toppage_pc.innerHTML = calDateText;
            }
        })
        .catch(error => {
            console.error('Error:', error);
        });
    }

    </script>



