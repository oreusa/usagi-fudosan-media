~20",4:"20~50",5:"50~100",6:"100~200",7:"200~500",8:"500~1000",9:"1000~2000",10:"2000~5000",11:"5000 or more"}}},census:{header:"Census (250-meter grid squares  Population)",table:{td:{1:"0~5",2:"5~10",3:"10~20",4:"20~50",5:"50~100",6:"100~200",7:"200~500",8:"500~1000",9:"1000~2000",10:"2000~5000",11:"5000 or more"}},note:"*Statistical disclosure control is shown in gray"},passengersByStation:{header:"Number of passengers per station",table:{td:"Number of passengers per station"}},denselyInhabitedDistrict:{header:"Densely Inhabited District",table:{td:"Densely Inhabited District"}}}},manual:{title:"Webの利用方法（地図表示）",abstract:"「地図表示」のヘルプでは、概要、操作説明を通して、システムの利用方法を説明します。",close:"閉じる",subtitle:"目次",links:{link1:"1. 共通画面",link2:"2. トップ画面",link3:"3. 地図表示画面",link3_1:"3.1. 地図表示エリア",link3_1_1:"（1） 表示コンテンツ一覧",link3_2:"3.2. 地域検索ボタン",link3_3:"3.3. コンテンツ選択ドロップダウン",link4:"4. 問い合わせ画面"},points:"　・・・　",abstracts:{abstract1:"共通画面の見方や主要な機能、操作方法を説明します。",abstract2:"トップ画面の見方や主要な機能、操作方法を説明します。",abstract3:"地図表示画面の見方や主要な機能、操作方法を説明します。",abstract3_1:"地図表示エリアの見方や主要な機能、操作方法を説明します。",abstract3_1_1:"地図上コンテンツの見方や主要な機能、操作方法を説明します。",abstract3_2:"地域検索ボタンの見方や主要な機能、操作方法を説明します。",abstract3_3:"コンテンツ選択ドロップダウンの見方や主要な機能、操作方法を説明します。",abstract4:"問い合わせ画面の見方や主要な機能、操作方法を説明します。"},details:{detail1:{heading:"1. 共通画面",contents1:"　本システムの共通の要素として、ヘッダーとフッター、サイドメニューがあります。",diagram1_1:"図表 1-1「共通画面」",diagram1_2:{title:"図表 1-2「共通画面における機能一覧」",tableheader1:"番号",tableheader2:"項目",tableheader3:"機能説明",description1:{number:"①",item:"共通ヘッダー",explanation1:"「不動産情報ライブラリ」リンクをクリックすると、トップ画面を表示できます。",explanation2:"「Language」リンクをクリックすると、画面に表示される言語を選択できます。",explanation3:"メニューアイコンをクリックすると、サイドメニューが表示されます。"},description2:{number:"②",item:"共通フッター",explanation1:"サイトマップでは、不動産情報ライブラリの各画面を表示できます。",explanation2:"各種リンク先では、本システムに関連するホームページを表示できます。"},description3:{number:"③",item:"サイドメニュー",explanation1:"不動産情報ライブラリの各画面を表示できます。",explanation2:"「閉じる」ボタンをクリックすると、サイドメニューを閉じます。"}}},detail2:{heading:"2. トップ画面 ",contents1:"　トップ画面では、不動産情報ライブラリの各画面を表示できます。",diagram2_1:"図表 2-1「トップ画面」",diagram2_2:{title:"図表 2-2「トップ画面における機能一覧」",tableheader1:"番号",tableheader2:"項目",tableheader3:"機能説明",description1:{number:"①",item:"地図表示",explanation1:"地図表示画面が表示されます。"},description2:{number:"②",item:"地図表示（地域検索）",explanation1:"地図表示画面が表示され、地図に表示したい地点を地域検索できます。"},description3:{number:"③",item:"データの検索・ダウンロード",explanation1:"不動産価格（取引価格・成約価格）情報の検索・ダウンロード画面が表示されます。"},description4:{number:"④",item:"主要都市における土地取引価格の概況",explanation1:"土地取引価格の概況画面が表示されます。"},description5:{number:"⑤",item:"データの検索",explanation1:"国土交通省地価公示・都道府県地価調査の検索画面が表示されます。"},description6:{number:"⑥",item:"データのダウンロード",explanation1:"鑑定評価書情報・地価公示のダウンロード画面が表示されます。"},description7:{number:"⑦",item:"不動産取引価格アンケート回答",explanation1:"土地取引状況調査のウェブ回答画面が表示されます。"},description8:{number:"⑧",item:"API利用申請",explanation1:"API利用申請画面が表示されます"},description9:{number:"⑨",item:"利用者アンケート",explanation1:"利用者アンケート回答画面が表示されます。"},description10:{number:"⑩",item:"API操作説明",explanation1:"AP利用における操作説明が表示されます。"},description11:{number:"⑪",item:"利用約款",explanation1:"利用約款画面が表示されます。"},description12:{number:"⑫",item:"Q&A・問い合わせ",explanation1:"Q&A・問い合わせ画面が表示されます。"},description13:{number:"⑬",item:"マニュアル・ヘルプ",explanation1:"本システムの利用方法が記載されているページの一覧が表示されます。"},description14:{number:"⑭",item:"コンテンツの出典",explanation1:"本システムで使用するコンテンツの出典一覧表が表示されます。"},description15:{number:"⑮",item:"お知らせ欄",explanation1:"お知らせを表示します。",explanation2:"重要なお知らせはトップ画面表示時にポップアップ表示されます。"}}},detail3:{heading:"3. 地図表示画面",contents1:"　地図表示画面では、土地・不動産関連情報を地図上に一度に重ね合わせて閲覧できます。不動産取引価格情報、地価公示、地価調査に加えて、成約価格情報、防災、都市計画、公共交通、教育・医療・福祉施設等に関するデータも取り扱っています。",contents2:"　地図表示画面の各ボタンやエリアの操作方法は以下の通りです。",diagram3_1:"図表 3-1「地図表示画面」",diagram3_2:{title:"図表 3-2「地図表示画面における機能一覧」",tableheader1:"番号",tableheader2:"項目",tableheader3:"機能説明",description1:{number:"①",item:"地域検索ボタン",explanation1:"住所検索（都道府県・市区町村、町字、丁目をキー）および路線・駅検索（路線・駅をキー）により、該当エリアに地図を表示させることができます。",explanation2:"詳細は「3.2. 地域検索ボタン」を参照。"},description2:{number:"②",item:"画面中心の街区表示ボタン",explanation1:"画面中心の街区表示ボタンをクリックすると、画面上の地図中心座標付近の街区を表示することができます。",explanation2:"画面中心の街区表示ボタンは縮尺レベルが「丁目」と「詳細」の時のみクリックできます。"},description3:{number:"③",item:"地図切り替えボタン",explanation1:"国土地理院地図へ切り替える。"},description4:{number:"④",item:"全レイヤの選択解除ボタン",explanation1:"⑥で選択したコンテンツレイヤを全て解除する。"},description5:{number:"⑤",item:"マニュアル表示リンク",explanation1:"Webの利用方法（地図表示）を表示できます。"},description6:{number:"⑥",item:"コンテンツ選択ドロップダウン",explanation1:"地図に重畳するコンテンツの選択（表示／非表示）ができます。",explanation2:"表示させるコンテンツのカテゴリは以下の通りです。",explanation3:"詳細は「3.3. コンテンツ選択ドロップダウン」を参照。",category1:"価格情報",category2:"地形情報",category3:"防災情報",category4:"周辺施設情報",category5:"都市計画情報等",category6:"人口情報等"},description7:{number:"⑦",item:"地図表示エリア",explanation1:"地図上に重畳された各種コンテンツを閲覧できます。",explanation2:"地図上で各コンテンツ（地物のポイント・ポリゴン等）を選択するとその名称や代表的な属性がポップアップで表示できます。",explanation3:"詳細は「3.1. 地図表示エリア」を参照。"},description8:{number:"⑧",item:"縮尺ボタン",explanation1:"選択した縮尺の地図を表示します。",explanation2:"選択できる縮尺は以下の通りです。",scale1:"詳細（縮尺距離：100m）",scale2:"丁目（縮尺距離：300m）",scale3:"大字（縮尺距離：500m）",scale4:"町（縮尺距離：1km）",scale5:"市（縮尺距離：3km）",scale6:"県（縮尺距離：10km）",scale7:"広域（縮尺距離：30km）",scale8:"日本全国（日本全体）"},description9:{number:"⑨",item:"凡例タブ",explanation1:"現在地図に表示している地図データの表示設定を確認することができます。"},description10:{number:"⑩",item:"ズームボタン",explanation1:"地図の縮尺を拡大縮小できます。"},description11:{number:"⑪",item:"縮尺ラベル",explanation1:"表示している地図の縮尺ラベルを表示します。"},description12:{number:"⑫",item:"トップ画面表示リンク",explanation1:"不動産情報ライブラリのトップページを表示できます。"},description13:{number:"⑬",item:"アンケート画面表示リンク",explanation1:"利用者アンケート画面を表示できます。"}}},detail3_1:{heading:"3.1. 地図表示エリア",contents1:"　地図表示エリアでは、地図上に重畳された各種コンテンツを閲覧できます。また、地図上で各コンテンツ（地物のポイント・ポリゴン等）を選択するとその名称や代表的な属性がポップアップで表示できます。",diagram3_3:"図表 3-3「地図表示エリア」",diagram3_4:{title:"図表 3-4「地図表示エリアにおける機能一覧」",tableheader1:"番号",tableheader2:"項目",tableheader3:"機能説明",description1:{number:"①",item:"表示コンテンツ",explanation1:"選択したコンテンツをポイント・ポリゴン・ラスタ画像として地図上で閲覧できます。また、地図上に表示されたコンテンツをクリックすると、その名称や代表的な属性等がポップアップで表示できます。",explanation2:"また、価格情報のポップアップ内の「詳細表示」リンクをクリックすると、別タブで詳細画面が表示されます。",explanation3:"表示コンテンツ一覧は「3.1.1. 表示コンテンツ一覧」 を参照。"},description2:{number:"②",item:"地図移動・拡大縮小",explanation1:"地図表示エリアをクリックし、移動したい方向にドラッグすることで、表示する地図を移動できます。また、マウスホイールを順方向に回すことで地図の縮尺を拡大、逆方向に回すことで地図の縮尺を縮小できます。"}}},detail3_1_1:{heading:"（1） 表示コンテンツ一覧",contents1:"　地図上に表示するコンテンツは以下の通りです。",diagram3_5:{title:"図表 3-5「表示コンテンツ一覧」",tableheader1:"分類",tableheader2:"コンテンツ",tableheader3:"説明",category1:{name:"価格情報",row1:{contents:"国土交通省地価公示",explanation1:"地価公示（国土交通省）の情報です。調査地点を地図上に表示するほか、詳細情報（鑑定評価書情報）を表示します。"},row2:{contents:"都道府県地価調査",explanation1:"都道府県地価調査の情報です。調査地点を地図上に表示します。"},row3:{contents:"不動産取引価格情報",explanation1:"不動産の取引価格情報提供制度で得られたアンケートに基づき、実際に行われた不動産の取引価格の情報です。調査対象地域の情報を地図上に表示するほか、詳細情報として不動産取引価格情報の調査項目を表示します。"},row4:{contents:"成約価格情報",explanation1:"REINS Market Information（RMI）から提供された成約価格情報です。調査対象地域の情報を地図上に表示するほか、詳細情報として成約価格情報の調査項目を表示します。"}},category2:{name:"地形情報",row1:{contents:"陰影起伏図",explanation1:"国土地理院の提供する、陰影起伏図データです。北西の方向から地表面に向かって光を当て、凹凸のある地表面の北西側が白く、南東側が黒くなるよう作成した図を地図上に表示します。"},row2:{contents:"土地条件図（数値地図25000）",explanation1:"国土地理院の提供する、土地条件図データです。地形分類（山地、台地・段丘、低地、水部、人工地形など）について地図上に表示します。"},row3:{contents:"大規模盛土造成地マップ",explanation1:"国土数値情報（国土交通省）の提供する、大規模盛土造成地の情報です。大規模盛土造成地を地図上に表示します。"}},category3:{name:"防災情報",row1:{contents:"洪水浸水想定区域（想定最大規模）",explanation1:"ハザードマップポータルサイト（国土地理院）の提供する、洪水浸水想定区域（想定最大規模）の情報です。区域を地図上に表示します。"},row2:{contents:"土砂災害警戒区域",explanation1:"ハザードマップポータルサイト（国土地理院）の提供する、土砂災害警戒区域の情報です。区域を地図上に表示します。"},row3:{contents:"津波浸水想定",explanation1:"ハザードマップポータルサイト（国土地理院）の提供する、津波浸水想定の情報です。区域を地図上に表示します。"},row4:{contents:"高潮浸水想定区域",explanation1:"ハザードマップポータルサイト（国土地理院）の提供する、高潮浸水想定区域等の情報です。区域を地図上に表示します。"},row5:{contents:"指定緊急避難場所",explanation1:"国土地理院の提供する、指定緊急避難場所データです。市町村等から国土地理院に情報提供された「指定緊急避難場所」に関する情報を地図上に表示します。"},row6:{contents:"災害危険区域",explanation1:"国土数値情報（国土交通省）の災害危険区域データです。災害危険区域に関する情報を地図上に表示します。"},row7:{contents:"急傾斜地崩壊危険区域",explanation1:"国土数値情報（国土交通省）の急傾斜地崩壊危険区域データです。都道府県知事が指定した急傾斜地崩壊危険区域に関する情報を地図上に表示します。"},row8:{contents:"地すべり防止地区",explanation1:"国土数値情報（国土交通省）の地すべり防止地区データです。国土交通大臣又は農林水産大臣が指定した地すべり防止区域に関する情報を地図上に表示します。"},row9:{contents:"地形区分に基づく液状化の発生傾向図",explanation1:"国土交通省都市局の地形区分に基づく液状化の発生傾向図データです。地形が示す一般的な地盤特性に対応した相対的な液状化発生傾向の強弱を5段階区分で表したものを地図上に表示します。"},row10:{contents:"災害履歴（水害、土砂災害、地震災害）",explanation1:"国土調査の一環として実施する土地分類基本調査（土地履歴調査）のうち、災害履歴の分布状況や災害種別・発生時期等を取りまとめた情報を地図上に表示します。"}},category4:{name:"周辺施設情報",row1:{contents:"保育園・幼稚園等",explanation1:"国土数値情報（国土交通省）の学校データ及び福祉施設データの幼稚園、こども園、保育園等のデータです。幼稚園・こども園・保育園を地図上に表示します。"},row2:{contents:"小学校区",explanation1:"国土数値情報（国土交通省）の小学校区データです。市区町村の教育委員会等が指定する小学校別の一定の通学範囲となる「通学区域」に関する情報を地図上に表示します。"},row3:{contents:"中学校区",explanation1:"国土数値情報（国土交通省）の中学校区データです。市区町村の教育委員会等が指定する中学校別の一定の通学範囲となる「通学区域」に関する情報を地図上に表示します。"},row4:{contents:"学校",explanation1:"国土数値情報（国土交通省）の学校データです。学校教育法に規定する全国の義務教育学校、高等学校、中等教育学校、特別支援学校、大学、高等専門学校、専修学校、各種学校に関する情報を地図上に表示します。",explanation2:"幼稚園、こども園の情報は当データ項目には掲載しません。"},row5:{contents:"市区町村役場及び集会施設等",explanation1:"国土数値情報（国土交通省）の市町村役場等及び公的集会施設データです。全国の特別区と市町村の事務所に関する情報を地図上に表示します。"},row6:{contents:"図書館",explanation1:"国土数値情報（国土交通省）の文化施設データの内、図書館の情報のみ、地図上に表示します。"},row7:{contents:"医療機関",explanation1:"国土数値情報（国土交通省）の医療機関データです。全国の医療機関の内、医療法に基づく「病院」「（一般）診療所」「歯科診療所」に関する情報を地図上に表示します。"},row8:{contents:"福祉施設",explanation1:"国土数値情報（国土交通省）の福祉施設データです。高齢者福祉、障がい者福祉、児童福祉施設に関する情報を地図上に表示します。こども園、保育園等の情報は当データ項目には掲載しません。"},row9:{contents:"自然公園地域",explanation1:"国土数値情報（国土交通省）の自然公園地域データです。国土利用計画法で指定する自然公園地域に関する情報を地図上に表示します。"}},category5:{name:"都市計画情報等",row1:{contents:"用途地域",explanation1:"国土交通省都市局がとりまとめた用途地域データです。都市計画法に基づき指定された地域地区に関する情報を地図上に表示します。"},row2:{contents:"都市計画区域/区域区分",explanation1:"国土交通省都市局でとりまとめた都市計画区域及び区域区分のデータです。都市計画法に基づき、都道府県等が定める都市計画区域及び区域区分を地図上に表示します。"},row3:{contents:"立地適正化計画",explanation1:"国土交通省都市局がとりまとめた立地適正化計画データです。立地適正化計画における立地適正化計画区域、居住誘導区域及び都市機能誘導区域に関する情報を地図上に表示します。"},row4:{contents:"防火・準防火地域",explanation1:"国土交通省都市局の防火・準防火地域データです。防火・準防火地域に関する情報を地図上に表示します。"},row5:{contents:"都市計画道路",explanation1:"市区町村が定めた都市計画道路を表示します。都市計画道路とは、都市計画法に基づいてルートや幅員があらかじめ定められた都市の骨格を形成する道路で、交通の円滑化、防災、物流促進、景観形成など多様な機能を持っています。"},row6:{contents:"高度利用地区",explanation1:"国土交通省都市局がとりまとめた高度利用地区データです。都市計画法に基づき、市町村等が定める高度利用地区を地図上に表示します。"},row7:{contents:"地区計画",explanation1:"国土交通省都市局がとりまとめた地区計画データです。都市計画法に基づき、市町村等が定める地区計画を地図上に表示します。"}},category6:{name:"人口情報等",row1:{contents:"将来推計人口250mメッシュ",explanation1:"国土数値情報（国土交通省）の250mメッシュ別将来推計人口データです。「国勢調査に関する地域メッシュ統計」（総務省統計局）に基づき、将来人口の試算結果を250mメッシュで表示します。"},row2:{contents:"国勢調査（250ｍメッシュ　人口）",explanation1:"「国勢調査に関する地域メッシュ統計」（総務省統計局）に基づき、世代別人口の集計結果を250mメッシュで表示します。"},row3:{contents:"駅別乗降客数",explanation1:"国土数値情報（国土交通省）の駅別乗降客数データです。全国の鉄道事業者から収集した駅別乗降客数を整備した情報を地図上に表示します。"},row4:{contents:"人口集中地区",explanation1:"国土数値情報（国土交通省）の人口集中地区データです。国勢調査の基本単位区を基礎単位とし、市区町村の境域内で人口密度の高い地域として設定された人口集中地区（DID）の情報を地図上に表示します。"}}}},detail3_2:{heading:"3.2. 地域検索ボタン",contents1:"　地域検索ボタンをクリックすると、以下の地域検索タブが表示されます。",diagram3_6:"図表 3-6「地域検索タブ」",diagram3_7:{title:"図表 3-7「地域検索タブにおける機能一覧」",tableheader1:"番号",tableheader2:"項目",tableheader3:"機能説明",description1:{number:"①",item:"住所からの場合/駅からの場合",explanation1:"地図表示したい対象地域を指定します。",explanation2:"「住所からの場合」を選択した場合、都道府県・市区町村・地区・丁目をプルダウンメニューから指定することができます。都道府県が選択されていれば、市区町村・地区・丁目まで指定する必要はありません。",explanation3:"「路線・駅名からの場合」を選択した場合、地方・路線・駅を指定することができます。駅についてはフリーワード検索することができます。"},description2:{number:"②",item:"キャンセルボタン",explanation1:"キャンセルボタンをクリックすると、地域検索タブを閉じます。"},description3:{number:"③",item:"地図表示ボタン",explanation1:"指定した条件で地図表示ボタンをクリックすると、該当エリアに地図を表示させることができます。"}}},detail3_3:{heading:"3.3. コンテンツ選択ドロップダウン",contents1:"　コンテンツ選択ドロップダウンをクリックすると、カテゴリごとにタブが表示されます。",diagram3_8:"図表 3-8「コンテンツ選択ドロップダウン」",diagram3_9:{title:"図表 3-9「コンテンツ選択ドロップダウンにおける機能一覧」",tableheader1:"番号",tableheader2:"項目",tableheader3:"機能説明",description1:{number:"①",item:"表示/非表示チェックボックス",explanation1:"表示したいコンテンツにチェックをつけて「決定ボタン」をクリックすると、チェックしたコンテンツを地図表示することができます。また、チェックを外し「決定ボタン」をクリックすると非表示になります。"},description2:{number:"②",item:"ツールチップ",explanation1:"ツールチップにマウスカーソルを合わせると、用語の解説やデータの出典元、整備時期が表示される。「詳細はこちらリンク」をクリックすると、より詳細な解説が記載されたページが別タブで表示されます。"},description3:{number:"③",item:"条件設定ボタン",explanation1:"条件設定ボタンをクリックすると、条件設定タブが表示され、チェックボックスやプルダウンで選択した条件のコンテンツを地図表示できます。"},description4:{number:"④",item:"塗りつぶしトグル",explanation1:"「塗りつぶしあり」を選択した場合、地図表示されるポリゴンが色付きの状態で表示されます。"},description5:{number:"⑤",item:"キャンセルボタン",explanation1:"キャンセルボタンをクリックすると、タブを閉じます。"},description6:{number:"⑥",item:"決定ボタン",explanation1:"表示/非表示チェックボックスや条件設定ボタンで設定されたコンテンツが地図上に表示されます。"}}},detail4:{heading:"4. 問い合わせ画面",contents1:"　問い合わせ画面では、不動産情報ライブラリのよくある質問のFAQを表示します。また、当サイトのお問い合わせを送信できます。",diagram4_1:"図表 4-1「問い合わせ画面」",diagram4_2:{title:"図表 4-2「問い合わせ画面における機能一覧」",tableheader1:"番号",tableheader2:"項目",tableheader3:"機能説明",description1:{number:"①",item:"FAQエリア",explanation1:"FAQエリアでは、カテゴリごとに質問とそれに対する回答を表示します。"},description2:{number:"②",item:"お名前フォーム",explanation1:"お問い合わせする方のお名前を入力します。"},description3:{number:"③",item:"メールアドレス/確認用メールアドレスフォーム",explanation1:"お問い合わせする方のメールアドレスを入力します。 \n ※必須項目"},description4:{number:"④",item:"お問い合わせの種別セレクター",explanation1:"お問い合わせの種別を選択します。 \n ※必須項目"},description5:{number:"⑤",item:"お問い合わせ内容フォーム",explanation1:"お問い合わせ内容を入力します。 \n ※必須項目"},description6:{number:"⑥",item:"送信ボタン",explanation1:"お問い合わせ内容を送信します。必須項目をすべて入力しないと送信できません。"}}}}},alert:{queryParam:"The content information of the map view screen could not be restored because an invalid query parameter was detected."}},realEstatePrices:{breadcrumb:{top:"Top",realEstatePrices:"Real Estate Price (Transaction Price/Contract Price) Information Search/Download"},goToHelp:"Manual",goToHelpAbout:" System and terms",title:"Real Estate Price (Transaction Price/Contract Price) Information Search/Download",transPrice:"To land transaction price overview screen",invalidToTop:"Back to Top",searchCondition:{title:"Search criteria setting",open:"Open criteria setting",close:"Close criteria setting",unselected:"Select",notInputted:"Enter",areaCondition:{title:"Area",address:"From address",addressSp:"Search from address",station:"By train line or station",stationSp:"Search by train line or station",prefectures:"Prefecture",municipalities:"City, ward, town or village",districts:"District",chome:"Chome",regions:"Region",routes:"Route",stations:"Station",freeword:"Select station by entering name"},priceCategoryCondition:{title:"Price information classification",transactionPrice:{label:"Real estate transaction price information",explanation1:"MLIT conducts questionnaire surveys of parties involved in real estate transactions, processes the collected information so that it cannot be easily identified, and releases information on transactions (transaction price, land area and shape, etc.) on a quarterly basis.Published prices are not corrected in any way except for rounding off values."},closedPrice:{label:"Contract price information",explanation:"Real estate transaction price information stored in the computer network system (REINS) operated by the real estate distribution organizations designated by MLIT, which is made available to the public by MLIT via REINS Market Information (RMI), a real estate transaction information service for consumers, after being processed so as to make individual transactions unidentifiable. Information on real estate transaction prices (contract prices) for condominiums and detached houses has been narrowed down in consideration of statistical accuracy and then processed so as to make individual transactions unidentifiable prior to being made available to the public."},linkDetail:"Click here for details"},kindCondition:{title:"Type",residential:"Residential lot (land, land and building)",used:"Pre-owned Condominiums, etc.",farmland:"Agricultural Land",woods:"Forest Land",place:"Land Only",building:"Land and Building",all:"All",note1:"*The only searchable contract price information is [land and building] and [used condominium, etc.].",note2:'*In the case of contract price information, "land and building" refers to "detached house."'},seasonCondition:{title:"Timing",wabeDash:"~",from:"~",error:"The end period cannot be set prior to the start period.",note1:"*The period that can be displayed on the map screen is the most recent five years."},currentCondition:{result:"Search results for current criteria: ",subject:"",note:"Up to 10,000 properties are shown in the list of search results. *See Notes for details)."},alert:{timeout1:"[Creating a file for download]",timeout2:"Due to the large amount of data to be retrieved, please wait a while and try again.",timeout3:"*The same search criteria must be set for a retry. ",timeout4:"Please leave search criteria as needed.",download:"An error occurred while downloading the ZIP file.",close:"Close"}},button:{dislpayList:"Display list",downloadList:"Download",initializeSortFilter:"Clear sort and filters"},displaySearchCondition:{title:"Display search criteria",searchCondition:{title:"Search criteria: ",areaTitle:"Area:",areaCondition:"<Region>",station:"Station",around:"Around",priceCategoryCondition:"[Price information classification]",transactionPrice:"Real estate transaction price information",closedPrice:"Contract price information",kindCondition:"<Type>",seasonCondition:"<Transaction period>",slash:" / ",wabeDash:"~",from:"From",to:"to"},transactionTotalNumbers:{from:"From",to:"to",land:"No. of land transactions in ",used:"No. of condominiums transactions in ",transactionNumber:"",totalDisplayNumberUnit:""},searchResult:{totalDisplayNumber:"Number of corresponding cases: ",totalDisplayNumberUnit:""}},screenTransition:{transNumber:"Show changes in the number of transactions",transMap:"Show corresponding map screen",transPrice:"Show land transaction price overview screen"},result:{title:{result:"List of search results",residential:"Real Estate Transaction Price Information [Residential Lot]",used:"Real Estate Transaction Price Information [Pre-owned Condominium, etc.]",farmland:"Real Estate Transaction Price Information [Agricultural Land]",woods:"Real Estate Transaction Price Information [Forest Land]",place:"Real Estate Transaction Price Information [Land]",building:"Real Estate Transaction Price Information [Land and Building]",all:"Real Estate Transaction Price Information [All]"},header:{details:"View details",no:"No.",type:"Type",priceInformationCategory:"Price information classification",location:"Address",region:"Area",nearestStation:"Nearest station",name:"Name",distance:"Distance",totalTransactionValue:"Total transaction value",exclusivelyOwnedArea:"Exclusively owned area",land:"Land",layout:"Layout",renovation:"Renovation",unitPriceTsubo:"Price per tsubo",area:"Area",unitPriceM2:"Price per m2",shape:"Shape",purposeOfUse:"Purpose of use",frontRoad:"Frontage road",breadth:"Width",classification:"Type",direction:"Direction",cityPlanning:"City planning",buildingCoverageRatio:"Building coverage ratio",floorAreaRatio:"Floor area ratio",transactionPeriod:"Transaction timing",transactionalFactors:"Transaction factors",building:"Building",totalFloorArea:"Total floor area",yearOfConstruction:"Construction year",structure:"Structure",use:"Use"},values:{renovationDone:"Renovated",renovationNot:"Not renovated"},notes:{title:"Notes",content1:"*The transaction price of real estate varies depending on individual factors such as area, shape, and the condition of the frontage road, and can even vary for the same piece of real estate depending on the circumstances of the transaction. Please keep these points in mind when viewing this information.",content2:"Also, the number of transaction price information data may change in the future depending on the status of survey collection. Note that especially in the latest term, there may be significant changes from the following term onward.",content3:"*The number of transactions in real estate transaction price information is the number of transactions gathered by transaction unit by MLIT and then compiled by area and transaction period. The number of land transactions is the number involving all land, including residential lot (land), residential lot (land and building), agricultural land, and forest land. The number of transactions for condominiums is the number for condominium units. When doing a search of everything, the number of transactions is the total of all of these transactions.",content4:"*The number of transactions in contract price information is based on the provision of transaction information that meets a certain standard number of transactions in the area concerned. This information may not be provided on an item-by-item basis because it may not be appropriate as market information when detects abnormal values.",content5:"*In some cases, duplicate data may be displayed in real estate transaction price information and contract price information.",content6:"*When the number of search results (number of properties that match your search criteria) exceeds 10,000, only 10,000 properties are displayed. To view all search results on the screen, change the search criteria or filter the data on the list of search results to reduce the number of search results to 10,000 or less.",content7:"*When you download search results, all information that matches your search criteria will be downloaded even if there are more than 10,000 search results. However, it may take some time to download."},balloon:{pic:"Indicates whether the information posted is based on real estate transaction price information (i.e., information from a survey conducted by MLIT) or contract price information (i.e., real estate transaction price information stored in the computer network system (REINS) operated by the real estate distribution organizations designated by MLIT, which is made available to the public by MLIT via REINS Market Information (RMI), a real estate transaction information service for consumers, after being processed so as to make individual transactions unidentifiable).",ns1:'Click the "Nearest station" link in the header to display the following scatter diagram for residential lot (land).',ns2:"Scatter diagram: Relationship between price per m2 of land and the distance to the nearest station (displayed only when searched by train line or st