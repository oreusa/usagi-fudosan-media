<!-- ==========================================
       インタラクション用 JavaScript
       ========================================== --> 
<script>
    // 6枚写真ギャラリーの左右スクロール
    function scrollHeroGallery(direction) {
      const container = document.getElementById('hero-photo-gallery');
      if (!container) return;
      const scrollAmount = container.clientWidth * 0.75;
      container.scrollBy({
        left: direction * scrollAmount,
        behavior: 'smooth'
      });
    }

    // スクロール連動：お城画像のぼかし（blur）＆暗幕（overlay）
    (function initScrollBlur() {
      const castleImg = document.getElementById('castle-main-img');
      const darkOverlay = document.getElementById('castle-dark-overlay');
      if (!castleImg || !darkOverlay) return;

      let ticking = false;

      function updateBlur() {
        const scrollY = window.pageYOffset || document.documentElement.scrollTop;
        const maxScroll = 450;
        const progress = Math.min(Math.max(scrollY / maxScroll, 0), 1);

        // ブラー: 0px から 最大12px まで滑らかにぼかし
        const blurAmount = (progress * 12).toFixed(1);
        castleImg.style.filter = `blur(${blurAmount}px) drop-shadow(0 10px 35px rgba(0,0,0,0.9))`;

        // 暗幕オーバーレイ: 0 から 最大0.75 まで徐々に暗くする
        darkOverlay.style.opacity = (progress * 0.75).toFixed(2);

        ticking = false;
      }

      window.addEventListener('scroll', function () {
        if (!ticking) {
          window.requestAnimationFrame(updateBlur);
          ticking = true;
        }
      }, { passive: true });

      // 初期実行
      updateBlur();
    })();
  </script>
