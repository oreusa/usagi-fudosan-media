<!-- 開閉機能 -->
<script>
document.addEventListener("DOMContentLoaded", function () {
  const toggleButtons = document.querySelectorAll(".toggle-detail");

  toggleButtons.forEach(button => {
    const itemDetail = button.previousElementSibling;
    const collapsedHeight = "4.5em"; // 閉じた状態の高さ

    // 初期化
    itemDetail.style.maxHeight = collapsedHeight;
    itemDetail.style.overflow = "hidden";

    button.addEventListener("click", function () {
      const isOpen = itemDetail.classList.contains("open");

      if (!isOpen) {
        // 開くとき
        itemDetail.classList.add("open");
        itemDetail.style.maxHeight = itemDetail.scrollHeight + "px";
        button.textContent = "▲ 閉じる";

        // アニメーション完了後に max-height を none に（必要なら）
        itemDetail.addEventListener("transitionend", function handler(e) {
          if (itemDetail.classList.contains("open")) {
            itemDetail.style.maxHeight = "none";
          }
          itemDetail.removeEventListener("transitionend", handler);
        });
      } else {
        // 閉じるとき：一旦 max-height を scrollHeight に戻してから縮める
        itemDetail.style.maxHeight = itemDetail.scrollHeight + "px";

        // 次のフレームで閉じる max-height を指定
        requestAnimationFrame(() => {
          itemDetail.classList.remove("open");
          itemDetail.style.maxHeight = collapsedHeight;
        });

        button.textContent = "▼ もっと見る";
      }
    });
  });
});
</script>
