      s.animate([{ opacity: 0, transform: 'scale(.2) rotate(0deg)' }, { opacity: .75, transform: 'scale(1) rotate(45deg)', offset: .5 }, { opacity: 0, transform: 'scale(.2) rotate(90deg)' }], { duration: 2400 + Math.random() * 1800, delay: Math.random() * 4000, iterations: Infinity, easing: 'ease-in-out' });
    }
  }
  componentWillUnmount() { clearInterval(this._swap); this._io && this._io.disconnect(); this._io2 && this._io2.disconnect(); }
  renderVals() {
    const months = [[2026,9],[2026,10],[2026,11],[2027,0],[2027,1],[2027,2]];
    const hol = new Set(['2026-11-03','2026-11-23','2027-01-01','2027-01-11','2027-02-11','2027-02-23','2027-03-21','2027-03-22']);
    const key = (y,m,d) => `${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const [y, m] = months[this.state.mi];
    const first = new Date(y, m, 1).getDay();
    const days = new Date(y, m + 1, 0).getDate();
    const cells = [];
    for (let i = 0; i < first; i++) cells.push({ isEmpty: true });
    for (let d = 1; d <= days; d++) {
      const dt = new Date(y, m, d), k = key(y, m, d), wd = dt.getDay();
      const weekendHol = wd === 0 || wd === 6 || hol.has(k);
      const inRange = dt >= new Date(2026, 9, 24) && dt <= new Date(2027, 2, 31);
      const limited = dt >= new Date(2027, 0, 4) && dt <= new Date(2027, 2, 19);
      const lp = inRange && (!limited || weekendHol);
      const ns = inRange && (weekendHol || (y === 2026 && m === 11 && d >= 28) || (y === 2027 && m === 2 && d >= 23));
      cells.push({ d, isEmpty: false, isOff: !lp, isLp: lp && !ns, isBoth: lp && ns });
    }
    return {
      months: months.map(([yy, mm], i) => ({
        label: `${mm + 1}月`, active: i === this.state.mi, inactive: i !== this.state.mi,
        select: () => this.setState({ mi: i })
      })),
      cells,
      aOp: this.state.pair ? 0 : 1,
      bOp: this.state.pair ? 1 : 0,
      stickyCta: this.props.stickyCta ?? true,
      showTicketDetails: this.props.showTicketDetails ?? false
    };
  }
}
</script>
