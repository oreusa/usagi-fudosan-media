  }).fail(function(XMLHttpRequest, textStatus, errorThrown){});
}

function joinByLang(strings, lang_id){
  var result = '';
  switch(lang_id){
    case 'en':
      if(strings.length <= 2){
        result = strings.join(' and ');
      }else{
        var last = strings.pop();
        result = strings.join(', ') + ', and ' + last;
      }
      break;
    case 'zh-hans':
    case 'zh-hant':
      result = strings.join('、');
      break;
    default:
      result = strings.join('・');
      break;
  }
  return result;
}

function getParam(name, url) {
