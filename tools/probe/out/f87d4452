	<script>
		$(document).ready(function(){
			var headmenu = $('body');
			$(document).ready(function(){
				$('#btn_menu').click(function(){
					$(this).toggleClass("active");
					headmenu.toggleClass("on_menu");
				});
				$(window).scroll(function () {
				if ($(this).scrollTop() > 170) {
						headmenu.addClass("on_fix");
				} else {
						headmenu.removeClass("on_fix");
						}
				});
			});
		});

		$(function() {
			$('.news_box').each(function() {
				const publishDateStr = $(this).data('publish-date');
				const publishDate = new Date(publishDateStr);
				const now = new Date();

				// 公開日から7日以内かどうかを判定
				const diffTime = now - publishDate;
				const diffDays = diffTime / (1000 * 60 * 60 * 24);

				if (diffDays <= 7 && diffDays >= 0) {
				$(this).addClass('new');
				}
			});
		});


		$('.switch button').on('click', function () {
			const $ul = $('.home_info ul');
			const fullHeight = $ul.prop('scrollHeight');

			$ul.animate({ height: fullHeight }, 400, function () {
			$ul.css('height', 'auto');
			});

			$('.switch').hide();
		});

		$(document).ready(function(){
			$('.slider').slick({
			autoplay: true,
			autoplaySpeed: 5000,
			speed: 1500,
			fade: true,
			dots: false,
			arrows: false,
			responsive: [
				{
				breakpoint: 768,
				settings: {
					dots: false
				}
				}
			]
			});
		});
	
