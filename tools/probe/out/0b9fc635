  z-index: 1 !important;
}

.illumination-overlay {
  position: absolute !important;
  top: 0;
  left: 0;

  width: 100%;
  height: 100%;

  z-index: 2 !important;

  background: linear-gradient(
    rgba(3, 5, 25, 0.15),
    rgba(3, 5, 25, 0.65)
  );
}

.illumination-content {
