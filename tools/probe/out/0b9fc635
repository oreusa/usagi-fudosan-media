/* === 背景だけに雪を降らせる (#1A315C 夜空ベース) === */
.snow-bg {
  position: relative;
  overflow: hidden;
  background-color: #1A315C;
  z-index: 0;
}

/* 雪エフェクト層 */
.snow-bg::before,
.snow-bg::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-repeat: repeat;
  background-image:
    radial-gradient(rgba(255,255,255,0.8) 1.5px, transparent 2px),
    radial-gradient(rgba(255,255,255,0.8) 1.2px, transparent 2px);
  background-size: 80px 80px, 120px 120px;
  opacity: 0.7;
  animation: snowMove 25s linear infinite;
  z-index: 0;
}

/* 手前と奥で動きをずらす */
.snow-bg::before {
  filter: blur(1px);
  animation-duration: 18s;
  opacity: 0.9;
}
.snow-bg::after {
  filter: blur(3px);
  animation-duration: 36s;
  opacity: 0.4;
}

/* 雪が縦にも横にも動く */
@keyframes snowMove {
  0%   { background-position: 0 0, 0 0; }
  25%  { background-position: 20px 250px, -10px 150px; }
  50%  { background-position: -20px 500px, 10px 300px; }
  75%  { background-position: 30px 750px, -20px 450px; }
  100% { background-position: 0 1000px, 0 600px; }
}

/* コンテンツを前面に */
.snow-bg > * {
  position: relative;
  z-index: 1;
}

.illumination-hero {
  position: relative;
  width: 100%;
  height: 100vh;
  min-height: 650px;
  overflow: hidden;
  background: #050516;
}

