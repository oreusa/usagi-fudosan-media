        nowTime = new Date();
        const diff = startTime.getTime() - nowTime.getTime();

        const calcDay = Math.floor(diff / 1000 / 60 / 60 / 24);
        const calcHour = Math.floor(diff / 1000 / 60 / 60) % 24;
        const calcMin = Math.floor(diff / 1000 / 60) % 60;
        const calcSec = Math.floor(diff / 1000) % 60;

        elemCountdownDay.innerHTML = calcDay;
        elemCountdownHour.innerHTML = calcHour < 10 ? '0' + calcHour : calcHour;
        elemCountdownMin.innerHTML = calcMin < 10 ? '0' + calcMin : calcMin;
        elemCountdownSec.innerHTML = calcSec < 10 ? '0' + calcSec : calcSec;
    }

